{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.4"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
:cljs {:extra-paths ["test"]
         :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
  ;; 公開サイトのマークアップ（site/inkan/page.cljc）。design system を引くので
  ;; ライブラリ本体の :paths からは外してある — inkan.geometry / inkan.svg は
  ;; clojure.string しか引かない状態を保つ。
  ;;
  ;; UI は kotoba-ui ではなく DADS（デジタル庁デザインシステム）。印影は
  ;; 印鑑登録・契約・行政手続きの文脈そのもので、jp-go-dds はまさにその用途の
  ;; ための明示的な opt-out 先（オーナー指示 2026-07-30、ADR-2607301300）。
  :site {:extra-paths ["site"]
         :extra-deps {io.github.kotoba-lang/jp-go-dds
                      {:local/root "../../kotoba-lang/jp-go-digital-design-system"}}}}}
