{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
:cljs {:extra-paths ["test"]
         :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
  ;; 公開サイトのマークアップ（site/inkan/page.cljc）。kotoba-ui を引くので
  ;; ライブラリ本体の :paths からは外してある — inkan.geometry / inkan.svg は
  ;; clojure.string しか引かない状態を保つ。
  :site {:extra-paths ["site"]
         :extra-deps {io.github.kotoba-lang/kotoba-ui {:local/root "../../kotoba-lang/kotoba-ui"}}}}}
